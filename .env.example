# Copy to .env and fill in. run.sh reads this file automatically, so no shell
# export is needed. A non-empty value already in the environment wins over the
# file, so one-off overrides still work:
#
#   LLM_GW_API_KEY=other-key ./run.sh --backend claude --model claude-opus-5 -p "..."
#
# Plain KEY=value per line — no quoting, no `export` prefix.

LLM_GW_BASE_URL=https://your-gateway.example.com
LLM_GW_API_KEY=sk-...
