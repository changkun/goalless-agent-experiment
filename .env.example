# Copy to .env and fill in. run.sh reads this file automatically, so no shell
# export is needed. A non-empty value already in the environment wins over the
# file, so one-off overrides still work:
#
#   LLM_GW_API_KEY=other-key ./run.sh --backend claude --model claude-opus-5 -p "..."
#
# Plain KEY=value per line — no quoting, no `export` prefix.

# LLM_GW_BASE_URL is a *surface* root, not the gateway root -- run.sh appends
# the backend's own path to it (Claude Code adds /v1/messages, codex adds
# /v1/responses). The bare gateway host serves neither and returns 405.
#
# The surface also differs per backend, so one file value cannot drive both
# arms; override it per run for whichever arm you are launching:
#
#   claude backend -> https://your-gateway.example.com/compat/anthropic
#                     (or /anthropic for a natively served Anthropic model)
#   codex backend  -> https://your-gateway.example.com/compat/openai
#
LLM_GW_BASE_URL=https://your-gateway.example.com/compat/anthropic
LLM_GW_API_KEY=sk-...
