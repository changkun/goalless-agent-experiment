}


def stamp(grid: Grid, cx: int, cy: int, pattern: List[Tuple[int, int]]) -> None:
    # Bounding box centering
    if not pattern:
        return
    minx = min(x for x, _ in pattern)
    maxx = max(x for x, _ in pattern)
    miny = min(y for _, y in pattern)
    maxy = max(y for _, y in pattern)
    pw, ph = maxx - minx + 1, maxy - miny + 1
    ox = cx - pw // 2
    oy = cy - ph // 2
    for x, y in pattern:
        grid.set(ox + (x - minx), oy + (y - miny), 1)


# --------------------------------------------------------------------------- #
# Renderer — curses wrapper that drives the simulation loop and handles input.
# ---------------------------------------------------------------------------

# Color palette for cell ages. We cycle through these so old cells shift hue.
AGE_COLORS = [1, 2, 3, 4, 5, 6, 7]  # color-pair indices (we'll define them)


def draw_help(win: "curses.window", h: int, w: int) -> None:
    lines = [
        "life-lab — cellular automaton playground",
        "",
        "  space    pause / resume",
        "  n        step (while paused)",
        "  c        clear",
        "  r        randomize",
        "  s / S    next / previous rule",
        "  arrows   move the seed cursor",
        "  1  glider       6  acorn",
        "  2  lwss         7  diehard",
        "  3  pulsar       8  glider gun (Life)",
        "  4  r-pentomino  9  block",
        "  5  pentadecathlon 0 beehive",
        "  h / ?    this help",
        "  q        quit",
        "",
        " press any key to close ",
    ]
    box_h = len(lines) + 2
    box_w = max(len(l) for l in lines) + 4
    sy = max(0, (h - box_h) // 2)
    sx = max(0, (w - box_w) // 2)
    try:
        sub = win.derwin(box_h, box_w, sy, sx)
    except curses.error:
        return
    sub.erase()
    sub.attron(curses.A_REVERSE)
    sub.border()
    sub.attroff(curses.A_REVERSE)
    for i, line in enumerate(lines):
        try:
            sub.addstr(1 + i, 2, line)
        except curses.error:
            pass
    sub.nodelay(False)
    sub.getch()
    sub.nodelay(True)


def main(stdscr: "curses.window", start_rule_idx: int, fps_target: float,
         density: float) -> None:
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(0)

    # Set up colors. Pair 0 is default. Pairs 1..7 are bright FG on black.
    curses.start_color()
    curses.use_default_colors()
    if curses.can_change_color():
        # Define pleasant custom colors (0..7 are reserved; use 8..14).
        try:
            curses.init_color(8,  1000, 300, 300)  # red
            curses.init_color(9,  1000, 650, 200)  # orange
            curses.init_color(10, 1000, 950, 250)  # yellow
            curses.init_color(11, 300, 1000, 500)  # green
            curses.init_color(12, 250, 850, 1000)  # cyan
            curses.init_color(13, 400, 550, 1000)  # blue
            curses.init_color(14, 800, 450, 1000)  # violet
            fg = [8, 9, 10, 11, 12, 13, 14]
        except curses.error:
            fg = list(range(1, 8))
    else:
        fg = list(range(1, 8))

    for i, c in enumerate(fg):
        try:
            curses.init_pair(i + 1, c, -1)
        except curses.error:
            curses.init_pair(i + 1, i + 1, -1)

    dead_pair = 0   # default
    grid_char_full = "█"
    grid_char_empty = "·"

    rule_idx = start_rule_idx
    rule = RULES[rule_idx]

    # Initialize grid sized to the window, leaving room for a stats bar.
    def make_grid() -> Grid:
        h, w = stdscr.getmaxyx()
        return Grid(w, max(1, h - 2))

    grid = make_grid()
    grid.randomize(density)
    gen = 0
    population = sum(1 for v in grid.cells if v > 0)
    paused = False
    cx, cy = grid.w // 2, grid.h // 2
    last_t = time.perf_counter()
    ema_fps = fps_target
    show_help = False

    def resize_if_needed() -> None:
        nonlocal grid, cx, cy
        h, w = stdscr.getmaxyx()
        if w != grid.w or (h - 2) != grid.h:
            new = Grid(w, max(1, h - 2))
            # copy overlap
            for y in range(min(grid.h, new.h)):
                for x in range(min(grid.w, new.w)):
                    new.set(x, y, grid.get(x, y))
            grid = new
            cx = min(cx, grid.w - 1)
            cy = min(cy, grid.h - 1)

    pattern_keys = ["1","2","3","4","5","6","7","8","9","0"]
    pattern_list = ["glider","lwss","pulsar","r-pentomino","pentadecathlon",
                    "acorn","diehard","glider_gun","block","beehive"]

    while True:
        now = time.perf_counter()
        dt = now - last_t
        last_t = now
        if dt > 0:
            ema_fps = 0.9 * ema_fps + 0.1 * (1.0 / dt)

        # -------- input --------
        ch = stdscr.getch()
        if ch == -1:
            pass
        elif ch in (ord("q"), ord("Q"), 27):  # q or ESC
            return
        elif ch == ord(" "):
            paused = not paused
        elif ch == ord("n") and paused:
            grid, population = grid.step(rule, gen)
            gen += 1
        elif ch == ord("c"):
            grid.clear()
            gen = 0
            population = 0
        elif ch == ord("r"):
            grid.randomize(density)
            gen = 0
            population = sum(1 for v in grid.cells if v > 0)
        elif ch == ord("s"):
            rule_idx = (rule_idx + 1) % len(RULES)
            rule = RULES[rule_idx]
        elif ch == ord("S"):
            rule_idx = (rule_idx - 1) % len(RULES)
            rule = RULES[rule_idx]
        elif ch == ord("h") or ch == ord("?"):
            show_help = True
        elif ch == curses.KEY_UP:
            cy = (cy - 1) % grid.h
        elif ch == curses.KEY_DOWN:
            cy = (cy + 1) % grid.h
        elif ch == curses.KEY_LEFT:
            cx = (cx - 1) % grid.w
        elif ch == curses.KEY_RIGHT:
            cx = (cx + 1) % grid.w
        elif ch in (ord("g"), ord("G")):
            if rule.name == "Life":
                stamp(grid, cx, cy, PATTERNS["glider_gun"])
        else:
            try:
                key = chr(ch)
            except (ValueError, OverflowError):
                key = ""
            if key in pattern_keys:
                idx = pattern_keys.index(key)
                name = pattern_list[idx]
                pat = PATTERNS.get(name, [])
                if pat:
                    # Special case: glider gun only makes sense under Life
                    if name == "glider_gun" and rule.name != "Life":
                        pat = PATTERNS["glider"]
                    stamp(grid, cx, cy, pat)

        # -------- simulate --------
        if not paused:
            if ema_fps < fps_target * 1.2:
                grid, population = grid.step(rule, gen)
                gen += 1

        # -------- render --------
        resize_if_needed()
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        gh = min(grid.h, h - 2)
        gw = min(grid.w, w)

        for y in range(gh):
            row = y * grid.w
            try:
                for x in range(gw):
                    age = grid.cells[row + x]
                    if age > 0:
                        pair = AGE_COLORS[(age - 1) % len(AGE_COLORS)]
                        # cursor marker overlays on the cell
                        ch_out = grid_char_full
                        try:
                            stdscr.addstr(y, x, ch_out, curses.color_pair(pair))
                        except curses.error:
                            pass
                    else:
                        if (x, y) == (cx, cy):
                            try:
                                stdscr.addstr(y, x, "+", curses.A_DIM)
                            except curses.error:
                                pass
                        else:
                            try:
                                stdscr.addstr(y, x, grid_char_empty, curses.A_DIM)
                            except curses.error:
                                pass
            except curses.error:
                continue

        # Stats bar (two lines at the bottom)
        status = (
            f"rule={rule.name}({rule.spec()}) "
            f"gen={gen} pop={population} "
            f"dens={population / max(1, grid.w * grid.h):.2%} "
            f"fps={ema_fps:.1f} "
            f"{'PAUSED' if paused else 'running'} "
            f"cursor=({cx},{cy})"
        )
        hint = "space=pause  s/S=rule  r=random  c=clear  1..0=pattern  h=help  q=quit"
        try:
            stdscr.addstr(h - 2, 0, status[:w-1], curses.A_REVERSE)
            stdscr.addstr(h - 1, 0, hint[:w-1], curses.A_DIM)
        except curses.error:
            pass

        stdscr.refresh()

        # Pace to target fps
        target_dt = 1.0 / fps_target
        elapsed = time.perf_counter() - now
        sleep = target_dt - elapsed
        if sleep > 0:
            time.sleep(sleep)

        if show_help:
            show_help = False
            draw_help(stdscr, h, w)
            stdscr.nodelay(True)


# --------------------------------------------------------------------------- #
# Entry point
# --------------------------------------------------------------------------- #

def cli() -> None:
    p = argparse.ArgumentParser(description="life-lab: cellular automaton playground")
    p.add_argument("--rule", type=str, default="Life",
                   help=f"starting rule ({', '.join(r.name for r in RULES)})")
    p.add_argument("--fps", type=float, default=20.0, help="target fps")
    p.add_argument("--density", type=float, default=0.28,
                   help="random fill density (0..1)")
    p.add_argument("--seed", type=int, default=None, help="RNG seed")
    args = p.parse_args()

    if args.seed is not None:
        random.seed(args.seed)

    idx = 0
    for i, r in enumerate(RULES):
        if r.name.lower() == args.rule.lower():
            idx = i
            break

    curses.wrapper(lambda stdscr: main(stdscr, idx, args.fps, args.density))


if __name__ == "__main__":
    cli()
